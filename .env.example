# Saudi Business | سعودي بزنس — environment template.
# Copy to .env and fill values locally. NEVER commit real secrets.
# Names only here; all real values come from your environment / Vercel.

# --- Core ---
APP_NAME=Saudi Business
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# --- Database ---
# When unset, the API runs in safe demo mode (in-memory, non-persistent).
# Set to a PostgreSQL URL to enable persistence, e.g.:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional AI provider (app works fully without this) ---
AI_PROVIDER=none
AI_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=
