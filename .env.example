# Saudi Business | سعودي بزنس — environment template.
# Copy to .env and fill values locally. NEVER commit real secrets.
# Names only here; all real values come from your environment / Vercel.

# --- Core ---
APP_NAME=Saudi Business
ENVIRONMENT=development
# CORS allowed origins. Accepts a JSON list (["https://a","https://b"]) or a
# comma-separated string (https://a,https://b). Leave EMPTY in development to
# get safe localhost defaults (localhost/127.0.0.1 on :3000 and :8000).
# In production you MUST list explicit origins: a wildcard "*" is never served
# in production and is never combined with credentials (see resolve_cors in
# backend/app/core/config.py). Use your own deployed origins, e.g.:
#   CORS_ORIGINS=["https://your-frontend.example.com"]
CORS_ORIGINS=

# --- Database ---
# Runtime engine URL resolution priority (see backend/app/db.py):
#   1. DATABASE_URL       (explicit override)
#   2. POSTGRES_URL       (Vercel/Neon managed integration)
#   3. development-only demo fallback (SQLite file; NEVER used in production)
# When none is set OUTSIDE production, the API runs in safe demo mode
# (non-persistent) and /health reports persistence accordingly. In production,
# a missing database URL fails safely instead of silently writing to a file.
# Names only here -- never commit a real credentialed URL. Example shape:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Direct / non-pooling URL for Alembic migrations. Serverless runtime traffic
# may use the pooled URL above, but migrations must run against a direct
# (non-pooling) connection. Priority (see database/migration_url.py):
#   1. DIRECT_DATABASE_URL       (explicit operator override -- wins over all)
#   2. POSTGRES_URL_NON_POOLING  (Vercel/Neon direct endpoint)
#   3. DATABASE_URL / 4. POSTGRES_URL (fallback if no direct URL is set)
# When both direct variables are set, DIRECT_DATABASE_URL takes precedence.
DIRECT_DATABASE_URL=
POSTGRES_URL_NON_POOLING=

# --- Auth ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Optional AI provider (app works fully without this) ---
AI_PROVIDER=none
AI_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=
