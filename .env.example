# Saudi-Buisness V1 — copy to .env and replace all production secrets.
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_WEB_URL=http://localhost:3000

# SMTP account used for verification and password-reset links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
API_PORT=8000
WEB_PORT=3000

# Optional when running services separately
# DATABASE_URL=postgresql://user:password@host:5432/saudi_business
# BACKEND_API_URL=http://localhost:8000
# Required by hosted Next.js deployments; never defaults to an external service.
# BACKEND_API_URL=https://api.your-domain.example
# CORS_ORIGINS=https://your-domain.example
